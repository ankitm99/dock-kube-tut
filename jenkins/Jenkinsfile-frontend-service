pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    environment {
        AWS_REGION = 'us-east-1'
        AWS_ACCOUNT_ID = '707360336863'
        ECR_REPOSITORY = 'frontend-service'
        GITOPS_REPOSITORY = 'git@github.com:ankitm99/dock-kube-tut-gitops.git'
        GITOPS_CREDENTIALS_ID = 'git-ssh'
    }

    stages {
        stage('Build Frontend') {
            steps {
                dir('frontend-service') {
                    sh 'npm ci'
                    sh 'npm run build'
                }
            }
        }

        stage('Build and Push Image to ECR') {
            steps {
                script {
                    env.IMAGE_TAG = env.BUILD_NUMBER
                    env.ECR_REGISTRY = "${env.AWS_ACCOUNT_ID}.dkr.ecr.${env.AWS_REGION}.amazonaws.com"
                    env.IMAGE_URI = "${env.ECR_REGISTRY}/${env.ECR_REPOSITORY}:${env.IMAGE_TAG}"
                }
                sh '''
                    set -eu
                    aws ecr get-login-password --region "$AWS_REGION" \
                      | docker login --username AWS --password-stdin "$ECR_REGISTRY"
                    docker build \
                      --platform linux/amd64 \
                      --tag "$IMAGE_URI" \
                      --file frontend-service/Dockerfile \
                      frontend-service
                    docker push "$IMAGE_URI"
                '''
            }
        }

        stage('Update Image Tag in GitOps') {
            steps {
                sshagent(credentials: [env.GITOPS_CREDENTIALS_ID]) {
                    sh '''
                        set -eu
                        rm -rf -- gitops
                        git clone "$GITOPS_REPOSITORY" gitops
                        cd gitops
                        VALUES_FILE="helm/microservices-app/values-prod.yaml"
                        test -f "$VALUES_FILE"

                        awk '
                            /^frontendService:/ { in_section = 1; next }
                            /^[^[:space:]]/ { in_section = 0 }
                            in_section && /^[[:space:]]+tag:/ { found++ }
                            END { exit found != 1 }
                        ' "$VALUES_FILE" || {
                            echo "Expected exactly one frontendService image tag in $VALUES_FILE" >&2
                            exit 1
                        }

                        sed -i.bak -E \
                          '/^frontendService:/,/^[^[:space:]]/ s/^([[:space:]]+tag:[[:space:]]*).*/\\1'"$IMAGE_TAG"'/' \
                          "$VALUES_FILE"
                        rm -f "$VALUES_FILE.bak"

                        git config user.name "Jenkins"
                        git config user.email "jenkins@users.noreply.github.com"
                        git diff --check
                        if git diff --quiet -- "$VALUES_FILE"; then
                            echo "GitOps image tag is already up to date."
                            exit 0
                        fi
                        git add "$VALUES_FILE"
                        git commit -m "Deploy frontend-service ${IMAGE_TAG}"
                        git push origin HEAD
                    '''
                }
            }
        }
    }

    post {
        always {
            sh 'docker logout "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com" >/dev/null 2>&1 || true'
        }
    }
}
